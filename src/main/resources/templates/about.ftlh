<#import "layout.ftlh" as l>
<@l.page title="About" active="about">

    <h1 class="text-center mt-5">About this Gallery</h1>
    <div class="container">
        <div class="row">
            <div class="col-md-9">
                <h3>Welcome to the Stardew Valley Character Gallery</h3>
                <p>The Stardew Valley Character Gallery showcases some characters from country-life RPG Stardew Valley.</p>
                <h3>Data and Attribution</h3>
                <p>All images and information come from the <a href="https://stardewvalleywiki.com/Stardew_Valley_Wiki">Stardew Valley Wiki</a>. Content pulled from video game Stardew Valley from game developer ConcernedApe.</p> 
                
            </div>
            <div class="col-md-3">
                <img src="/thumbnails/coop.png" class="img-thumbnail" alt="In-game chicken coop and animals">
            </div>
        </div>
    </div>

    
    <div class="text-center">
    <img src="/thumbnails/svLogo.png" class="rounded" alt="Stardew Valley logo">
    </div>
    
</@l.page>
