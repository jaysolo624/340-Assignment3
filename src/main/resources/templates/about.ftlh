<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Character Gallery</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>

    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-warning">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">
                <img src="/thumbnails/chicken.ico" alt="Logo" width="25" height="25" class="d-inline-block align-text-top">
                Stardew Valley Gallery

            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup"
                aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
                <div class="navbar-nav">
                    <a class="nav-link" href="index">Home</a>
                    <a class="nav-link" href="details">Details</a>
                    <a class="nav-link active" aria-current="page" href="about">About</a>
                    <a class="nav-link" href="new-character-form">Add Character</a>
                </div>
            </div>
        </div>
    </nav>

    <h1 class="text-center mt-5">About this Gallery</h1>
    <div class="container">
        <div class="row">
            <div class="col-md-9">
                <h3>Welcome to the Stardew Valley Character Gallery</h3>
                <p>The Stardew Valley Character Gallery showcases some characters from country-life RPG Stardew Valley.</p>
                <h3>Data and Attribution</h3>
                <p>All images and information come from the <a href="https://stardewvalleywiki.com/Stardew_Valley_Wiki">Stardew Valley Wiki</a>. Content pulled from video game Stardew Valley from game developer ConcernedApe.</p> 
                
            </div>
            <div class="col-md-3">
                <img src="/thumbnails/coop.png" class="img-thumbnail" alt="In-game chicken coop and animals">
            </div>
        </div>
    </div>

    
    <div class="text-center">
    <img src="/thumbnails/svLogo.png" class="rounded" alt="Stardew Valley logo">
    </div>
    

</body>

</html>